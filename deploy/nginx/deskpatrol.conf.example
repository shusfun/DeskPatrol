map $http_upgrade $deskpatrol_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl http2;
    server_name deskpatrol.example.com;

    ssl_certificate /etc/letsencrypt/live/deskpatrol.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/deskpatrol.example.com/privkey.pem;

    location = /meshrelay.ashx {
        proxy_pass http://127.0.0.1:18129;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $deskpatrol_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
    }

    location = /sharing {
        proxy_pass http://127.0.0.1:18129;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ~ ^/(scripts|styles|images|sounds)/ {
        proxy_pass http://127.0.0.1:18129;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ~ ^/(favicon(?:-16x16|-32x32|-303x303)?\.png|favicon\.ico|manifest\.json)$ {
        proxy_pass http://127.0.0.1:18129;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:18123;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 8443 ssl;
    server_name deskpatrol.example.com;

    ssl_certificate /etc/letsencrypt/live/deskpatrol.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/deskpatrol.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:18124;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $deskpatrol_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
    }
}
