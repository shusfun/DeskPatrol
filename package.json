{
  "name": "deskpatrol",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "22.22.0"
  },
  "scripts": {
    "repo": "node ./tools/repo-cli/src/index.mjs",
    "repo:help": "pnpm run repo -- help",
    "repo:doctor": "pnpm run repo -- doctor",
    "repo:status": "pnpm run repo -- status",
    "repo:setup-status": "pnpm run repo -- setup-status",
    "repo:deps": "pnpm run repo -- deps all",
    "repo:build": "pnpm run repo -- build all",
    "repo:dev": "pnpm run repo -- dev start",
    "repo:test": "pnpm run repo -- test all",
    "repo:verify": "pnpm run repo -- verify all",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "7.0.2",
    "vite": "7.1.9",
    "vitest": "3.2.4",
    "tailwindcss": "4.3.0"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0-alpha2.117",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
